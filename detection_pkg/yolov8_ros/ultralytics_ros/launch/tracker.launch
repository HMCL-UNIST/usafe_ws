<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="debug" default="false"/>
  <arg name="yolo_model" default="yolov8n-seg.pt"/>
  <!-- <arg name="yolo_model" default="imgsz1280_batch_18_v8nseg.pt"/> -->
  <arg name="input_topic" default="/camera/front_60/camera/image_raw/compressed"/>
  <!-- <arg name="input_topic" default="/camera/front_60/camera/image_rect_color/compressed"/> -->
  <arg name="camera_info_topic" default="/camera/front_60/camera/camera_info"/>
  <arg name="result_topic" default="/detection/yolo_60_result"/>
  <arg name="result_image_topic" default="/detection/yolo_60_image"/>
  <arg name="conf_thres" default="0.3"/>
  <arg name="iou_thres" default="0.45"/>
  <arg name="max_det" default="300"/>
  <arg name="classes" default=""/>   
  <arg name="tracker" default="bytetrack.yaml"/>
  <arg name="device" default="0"/>
  <arg name="result_conf" default="true"/>
  <arg name="result_line_width" default="4"/>
  <arg name="result_font_size" default="2"/>
  <arg name="result_font" default="Arial.ttf"/>
  <arg name="result_labels" default="true"/>
  <arg name="result_boxes" default="true"/>
  <arg name="result_masks" default="true"/>

  <node name="yolov8_ros_front_60" pkg="ultralytics_ros" type="tracker_node.py" output="log">
    <param name="yolo_model" value="$(arg yolo_model)"/>
    <param name="input_topic" value="$(arg input_topic)"/>
    <param name="camera_info_topic" value="$(arg camera_info_topic)"/>
    <param name="result_topic" value="$(arg result_topic)"/>
    <param name="result_image_topic" value="$(arg result_image_topic)"/>
    <param name="conf_thres" value="$(arg conf_thres)"/>
    <param name="iou_thres" value="$(arg iou_thres)"/>
    <param name="max_det" value="$(arg max_det)"/>
    <param name="tracker" value="$(arg tracker)"/>
    <param name="result_conf" value="$(arg result_conf)"/>
    <param name="result_line_width" value="$(arg result_line_width)"/>
    <param name="result_font_size" value="$(arg result_font_size)"/>
    <param name="result_font" value="$(arg result_font)"/>
    <param name="result_labels" value="$(arg result_labels)"/>
    <param name="result_boxes" value="$(arg result_boxes)"/>
    <rosparam param="classes" subst_value="true">$(arg classes)</rosparam>
    <rosparam param="device" subst_value="true">$(arg device)</rosparam>
  </node>

  <node name="yolov8_ros_front_r" pkg="ultralytics_ros" type="tracker_node.py" output="log">
    <param name="yolo_model" value="$(arg yolo_model)"/>
    <param name="input_topic" value="/camera/front_r/camera/image_raw/compressed"/>
    <param name="camera_info_topic" value="/camera/front_r/camera/camera_info"/>
    <param name="result_topic" value="/detection/yolo_r_result"/>
    <param name="result_image_topic" value="/detection/yolo_r_image"/>
    <param name="conf_thres" value="$(arg conf_thres)"/>
    <param name="iou_thres" value="$(arg iou_thres)"/>
    <param name="max_det" value="$(arg max_det)"/>
    <param name="tracker" value="$(arg tracker)"/>
    <param name="result_conf" value="$(arg result_conf)"/>
    <param name="result_line_width" value="$(arg result_line_width)"/>
    <param name="result_font_size" value="$(arg result_font_size)"/>
    <param name="result_font" value="$(arg result_font)"/>
    <param name="result_labels" value="$(arg result_labels)"/>
    <param name="result_boxes" value="$(arg result_boxes)"/>
    <rosparam param="classes" subst_value="true">$(arg classes)</rosparam>
    <rosparam param="device" subst_value="true">$(arg device)</rosparam>
  </node>

  <node name="yolov8_ros_front_l" pkg="ultralytics_ros" type="tracker_node.py" output="log">
    <param name="yolo_model" value="$(arg yolo_model)"/>
    <param name="input_topic" value="/camera/front_l/camera/image_raw/compressed"/>
    <param name="camera_info_topic" value="/camera/front_l/camera/camera_info"/>
    <param name="result_topic" value="/detection/yolo_l_result"/>
    <param name="result_image_topic" value="/detection/yolo_l_image"/>
    <param name="conf_thres" value="$(arg conf_thres)"/>
    <param name="iou_thres" value="$(arg iou_thres)"/>
    <param name="max_det" value="$(arg max_det)"/>
    <param name="tracker" value="$(arg tracker)"/>
    <param name="result_conf" value="$(arg result_conf)"/>
    <param name="result_line_width" value="$(arg result_line_width)"/>
    <param name="result_font_size" value="$(arg result_font_size)"/>
    <param name="result_font" value="$(arg result_font)"/>
    <param name="result_labels" value="$(arg result_labels)"/>
    <param name="result_boxes" value="$(arg result_boxes)"/>
    <rosparam param="classes" subst_value="true">$(arg classes)</rosparam>
    <rosparam param="device" subst_value="true">$(arg device)</rosparam>
  </node>

  <node name="yolov8_ros_back" pkg="ultralytics_ros" type="tracker_node.py" output="log">
    <param name="yolo_model" value="$(arg yolo_model)"/>
    <param name="input_topic" value="/camera/back/camera/image_raw/compressed"/>
    <param name="camera_info_topic" value="/camera/back/camera/camera_info"/>
    <param name="result_topic" value="/detection/yolo_b_result"/>
    <param name="result_image_topic" value="/detection/yolo_b_image"/>
    <param name="conf_thres" value="$(arg conf_thres)"/>
    <param name="iou_thres" value="$(arg iou_thres)"/>
    <param name="max_det" value="$(arg max_det)"/>
    <param name="tracker" value="$(arg tracker)"/>
    <param name="result_conf" value="$(arg result_conf)"/>
    <param name="result_line_width" value="$(arg result_line_width)"/>
    <param name="result_font_size" value="$(arg result_font_size)"/>
    <param name="result_font" value="$(arg result_font)"/>
    <param name="result_labels" value="$(arg result_labels)"/>
    <param name="result_boxes" value="$(arg result_boxes)"/>
    <rosparam param="classes" subst_value="true">$(arg classes)</rosparam>
    <rosparam param="device" subst_value="true">$(arg device)</rosparam>
  </node>

  <node name="camera_health_checker" pkg="ultralytics_ros" type="camera_health_checker.py" output="log">
    <param name="camera_info_src_f" value="/camera/front_60/camera/camera_info"/>
    <param name="camera_info_src_l" value="/camera/front_l/camera/camera_info"/>
    <param name="camera_info_src_r" value="/camera/front_r/camera/camera_info"/>
    <param name="camera_info_src_b" value="/camera/back/camera/camera_info"/>
  </node>


  <!-- <node if="$(arg debug)" name="image_view_60" pkg="image_view" type="image_view" output="screen">
    <remap from="image" to="$(arg result_image_topic)"/>
  </node> -->

  <!-- <node if="$(arg debug)" name="image_view_r" pkg="image_view" type="image_view" output="screen">
    <remap from="image" to="/detection/yolo_r_image"/>
  </node>

  <node if="$(arg debug)" name="image_view_l" pkg="image_view" type="image_view" output="screen">
    <remap from="image" to="/detection/yolo_l_image"/>
  </node> -->
</launch>

