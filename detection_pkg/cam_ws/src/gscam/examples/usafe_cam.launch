<node name="image_proc" pkg="image_proc" type="image_proc" output="screen" ns="/camera/front_60/camera/" />
<!-- <node name="image_proc" pkg="image_proc" type="image_proc" output="screen" ns="/camera/right/camera/" />
<node name="image_proc" pkg="image_proc" type="image_proc" output="screen" ns="/camera/left/camera/" /> -->
<node name="image_proc" pkg="image_proc" type="image_proc" output="screen" ns="/camera/front_l/camera/" />
<node name="image_proc" pkg="image_proc" type="image_proc" output="screen" ns="/camera/front_r/camera/" />


  <!-- <node if="$(arg PUBLISH_FRAME)" name="v4l_transform" pkg="tf" type="static_transform_publisher" args="1 2 3 0 -3.141 0 /world /v4l_frame 10"/> -->
</launch>
